<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../../src/Masar.Domain/Masar.Domain.csproj" />
    <None Include="../../../phase1/content/sample.json" Link="Fixtures/sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../phase1/content/graph.json" Link="Fixtures/graph.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/phase1-plans.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
